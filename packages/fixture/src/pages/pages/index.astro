---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const pages = (await getCollection("pages")).filter((p) => !p.data.draft);
---

<BaseLayout title="Pages">
  <main>
    <h1>Pages</h1>
    <ul>
      {
        pages.map((page) => (
          <li>
            <a href={`${base}pages/${page.id}/`}>{page.data.title}</a>
            {page.data.description && (
              <span class="desc">{page.data.description}</span>
            )}
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 40rem;
    padding: 2rem 0;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  a {
    color: var(--accent);
  }
  .desc {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
